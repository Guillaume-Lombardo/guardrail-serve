API_PORT=8000
API_PREFIX=
API_VERSION=0.1.0
PROJECT_NAME=guardrail-serve
SECRET_MASK=[REDACTED]
# Policy for LiteLLM requests without additional_provider_specific_params.policy.
# The deprecated LITELLM_GUARDRAIL_NAME is read only when this is empty.
LITELLM_DEFAULT_POLICY=detect_secret
# Optional directory overriding policies.yaml and pattern files (whole-file replacement).
# Missing secrets YAML uses native detection; explicit YAML replaces it entirely.
GUARDRAILS_CONFIG_DIR=
MAX_TEXT_ITEMS=20
MAX_TEXT_CHARS=20000
LOG_FORMAT=human
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
GUARDRAIL_API_KEYS=

# Bound concurrent parsing/validation; allow ~120 MiB per malformed 1 MiB request.
HTTP_MAX_CONCURRENT_REQUESTS=2

# Optional semantic policy detector; no provider is contacted when disabled.
SEMANTIC_ENABLED=false
SEMANTIC_URL=
SEMANTIC_FORMAT=scores
SEMANTIC_TIMEOUT=2s
SEMANTIC_THRESHOLD=0.9
SEMANTIC_FAILURE_MODE=closed
# Comma-separated labels, case-insensitive; used only by tei_predict.
SEMANTIC_MALICIOUS_LABELS=MALICIOUS
