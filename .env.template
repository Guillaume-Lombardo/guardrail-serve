API_PORT=8000
API_PREFIX=
API_VERSION=0.1.0
PROJECT_NAME=guardrail-serve
SECRET_MASK=[REDACTED]
# Policy for LiteLLM requests without additional_provider_specific_params.policy.
# The deprecated LITELLM_GUARDRAIL_NAME is read only when this is empty.
LITELLM_DEFAULT_POLICY=detect_secret
# Optional directory overriding policies.yaml and pattern files (whole-file replacement).
# Missing secrets YAML uses native detection; explicit YAML replaces it entirely.
GUARDRAILS_CONFIG_DIR=
MAX_TEXT_ITEMS=20
MAX_TEXT_CHARS=20000
LOG_FORMAT=human
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
GUARDRAIL_API_KEYS=

# Bound concurrent parsing/validation; allow ~120 MiB per malformed 1 MiB request.
HTTP_MAX_CONCURRENT_REQUESTS=2

# Optional semantic policy detector; no provider is contacted when disabled.
# A deployable CPU sidecar (format scores, URL .../classify) is in deploy/semantic-sidecar;
# its model, revision and labels are configured there (sidecar.env.template), not here.
SEMANTIC_ENABLED=false
SEMANTIC_URL=
SEMANTIC_FORMAT=scores
# Budget for ONE text including every chunk batch. CPU sidecar, 2 shared vCPUs, ~200 ms per 510-char chunk (86M model):
# 2s fails from ~10 chunks; MAX_TEXT_CHARS=20000 (~45 chunks) needs ~9s at low load, so 15s or more, and more under concurrency
# (inference is serialized). Keep HTTP_WRITE_TIMEOUT above the worst whole request. See deploy/semantic-sidecar.
SEMANTIC_TIMEOUT=2s
# Per-model: calibrate on your data. The sidecar returns probabilities and does not threshold.
SEMANTIC_THRESHOLD=0.9
# closed: sidecar failure (or over-long text rejected with 422) -> HTTP 502.
# open: the text passes and a "semantic classifier degraded" warning is logged.
SEMANTIC_FAILURE_MODE=closed
# Comma-separated labels, case-insensitive; used only by tei_predict. A checkpoint without id2label,
# such as Prompt Guard 2, is served with the labels LABEL_0 (benign) and LABEL_1 (malicious).
SEMANTIC_MALICIOUS_LABELS=MALICIOUS

# Optional System One judge (TypeSafe Jev), disabled by default; see README and ADR 0021.
# Texts are masked (detect_secret + detect_pii, typed masks) before any request; masking
# failure sends nothing. cascade requires SEMANTIC_ENABLED=true; judge_only requires false.
SYSTEMONE_ENABLED=false
SYSTEMONE_MODE=cascade
# Required when enabled: https base URL (http only for loopback); requests go to <base>/v1/systemone.
SYSTEMONE_BASE_URL=
# Required when enabled, e.g. jev-1.14.0 (pin a versioned ID once thresholds are tuned).
SYSTEMONE_MODEL=
# Exactly one key source when enabled. Prefer a file (mounted secret); never commit a key.
SYSTEMONE_API_KEY_FILE=
SYSTEMONE_API_KEY=
# noul, choice or score; the question wording is fixed in code.
SYSTEMONE_QUESTION=noul
# Probability in (0, 1]; equality triggers. Uncalibrated starting point.
SYSTEMONE_THRESHOLD=0.7
# Required in cascade: the judge is asked only when LOWER <= sidecar score <= UPPER (inclusive).
SYSTEMONE_ZONE_LOWER=
SYSTEMONE_ZONE_UPPER=
# Per text, texts judged sequentially; HTTP_WRITE_TIMEOUT bounds the whole request and cancels calls.
SYSTEMONE_TIMEOUT=3s
# Provider failures only; masking/size failures always fail the request.
SYSTEMONE_FAILURE_MODE=closed
SYSTEMONE_MAX_TEXT_RUNES=20000
