# Sidecar settings (see README.md). All values shown are the defaults.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8080
# Model: a full 40-character commit hash is mandatory; branches are refused.
# Default: Llama Prompt Guard 2 86M (Llama 4 Community License, gated). Other pinned
# models are in profiles/*.env.
SIDECAR_MODEL_ID=meta-llama/Llama-Prompt-Guard-2-86M
SIDECAR_MODEL_REVISION=a8ded8e697ce7c355e395a0df51f94adb4a2fd27
# Directory with a local snapshot (the image sets /models/model); empty downloads from the Hub.
SIDECAR_MODEL_PATH=
# Labels counted as an attack (case-insensitive, validated against the checkpoint's id2label).
# Required for any model other than the default. Prompt Guard 2 ships no id2label, so its
# classes are LABEL_0 (benign) and LABEL_1 (malicious); the DeBERTa fallback uses INJECTION.
SIDECAR_MALICIOUS_LABELS=LABEL_1
# At load time, score one canary attack and one canary benign text and refuse to start if the
# label mapping is inverted or constant. Disable only for a model not meant to flag the canary.
SIDECAR_VERIFY_LABELS=true
SIDECAR_MAX_BODY_BYTES=1048576
SIDECAR_MAX_TEXTS=32
SIDECAR_MAX_TOKENS=512
SIDECAR_MAX_INFLIGHT=4
SIDECAR_MAX_CONNECTIONS=32
SIDECAR_REQUEST_TIMEOUT_SECONDS=10
SIDECAR_INFERENCE_TIMEOUT_SECONDS=10
SIDECAR_BATCH_SIZE=8
# 0 keeps the PyTorch default.
SIDECAR_TORCH_THREADS=0
# Upper bound on how long SIGTERM waits for in-flight requests before exiting. Keep the
# container stop timeout (compose stop_grace_period, docker run --stop-timeout) above it.
SIDECAR_SHUTDOWN_GRACE_SECONDS=20
