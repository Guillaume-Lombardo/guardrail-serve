# Sidecar settings (see README.md). All values shown are the defaults.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8080
# Model: a full 40-character commit hash is mandatory; branches are refused.
SIDECAR_MODEL_ID=protectai/deberta-v3-base-prompt-injection-v2
SIDECAR_MODEL_REVISION=90c9989b1a342275dd0d1a95aad283c04e075671
# Directory with a local snapshot (the image sets /models/model); empty downloads from the Hub.
SIDECAR_MODEL_PATH=
# Labels counted as an attack (case-insensitive, validated against the checkpoint's id2label).
# Required for any model other than the default. Prompt Guard 2: MALICIOUS.
SIDECAR_MALICIOUS_LABELS=INJECTION
SIDECAR_MAX_BODY_BYTES=1048576
SIDECAR_MAX_TEXTS=32
SIDECAR_MAX_TOKENS=512
SIDECAR_MAX_INFLIGHT=4
SIDECAR_MAX_CONNECTIONS=32
SIDECAR_REQUEST_TIMEOUT_SECONDS=10
SIDECAR_INFERENCE_TIMEOUT_SECONDS=10
SIDECAR_BATCH_SIZE=8
# 0 keeps the PyTorch default.
SIDECAR_TORCH_THREADS=0
